pkgname=rdownloader
pkgver=0.1.0
pkgrel=1
pkgdesc="Clean-room Rust download manager with Tor"
arch=('x86_64' 'aarch64')
url="https://github.com/example/rdownloader"
license=('MIT')
depends=('gcc-libs')
makedepends=('rust' 'cargo')
source=("$pkgname-$pkgver.tar.gz::https://github.com/example/rdownloader/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/rdownloader" "$pkgdir/usr/bin/rdownloader"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
